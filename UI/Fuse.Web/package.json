{
  "name": "fuse-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:typecheck": "vue-tsc --noEmit -p tsconfig.tests.json",
    "generate:api": "cd ../.. && dotnet tool run nswag run nswag.json && UI/Fuse.Web/node_modules/.bin/prettier --write UI/Fuse.Web/src/api/client.ts"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "@tanstack/vue-query": "^5.105.1",
    "@vueuse/core": "^15.0.0",
    "cytoscape": "^3.34.4",
    "cytoscape-fcose": "^2.2.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7",
    "@vue/devtools-api": "^8.2.1"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "^2.0.2",
    "@types/cytoscape-fcose": "^2.2.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.3",
    "prettier": "3.6.2",
    "sass": "^1.107.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "js-beautify@2.0.3": {
      "glob": "14.0.3",
      "editorconfig@3.0.2": {
        "minimatch": "11.0.3"
      }
    }
  },
  "engines": {
    "node": ">=26 <27"
  }
}
